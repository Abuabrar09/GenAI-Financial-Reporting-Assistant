# Copy to .env (or set as Codespaces secrets / Streamlit Cloud secrets)
# Pick ONE provider. With no key, the app runs in offline (rule-based) mode.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# LLM_PROVIDER=anthropic   # or openai / offline

# Kaggle API (only needed to download the dataset with scripts/download_data.sh)
KAGGLE_USERNAME=
KAGGLE_KEY=
